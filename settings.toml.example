# Copy this file to settings.toml on CIRCUITPY.
# Never commit the real settings.toml.

# Independent board/display profiles fill blank resource settings but never
# enable hardware or assert electrical verification. MPG_HARDWARE_PROFILE is a
# compatibility alias for legacy deployments; prefer MPG_BOARD_PROFILE.
MPG_HARDWARE_PROFILE=""
MPG_BOARD_PROFILE="xiao_esp32s3"
MPG_DISPLAY_PROFILE="seeed_round_240"

CIRCUITPY_WIFI_SSID=""
CIRCUITPY_WIFI_PASSWORD=""

# DHCP/mDNS-friendly hostname. Keep it lowercase and avoid spaces.
MPG_HOSTNAME="cdaprod-cnc-pendant"
# Automatic fallback setup AP lifetime in seconds; 0 disables expiry.
MPG_NETWORK_AP_TIMEOUT="600"
# Maximum time for an individual station connection attempt.
MPG_NETWORK_CONNECT_TIMEOUT="15"

# disabled | uart | mock
MPG_CONTROLLER_MODE="disabled"

# Leave blank while mode=disabled.
MPG_CONTROLLER_HOST=""
MPG_CONTROLLER_PORT="8080"

# Direct GRBL 1.1 UART. Leave pins blank until electrical verification and a
# reviewed board GPIO allocation are complete. Values are board pin names.
MPG_UART_TX_PIN=""
MPG_UART_RX_PIN=""
MPG_UART_BAUDRATE="115200"

MPG_BASE_INCREMENT="0.001"
MPG_JOG_FEED="500"
MPG_STATUS_INTERVAL="0.2"
MPG_JOBS_PATH="/jobs"
MPG_MACROS_PATH="/macros"
MPG_PROBE_Z="G91 G38.2 Z-10 F100"
MPG_SAFE_Z="G53 G0 Z0"
MPG_PARK="G53 G0 X0 Y0"

# Physical inputs remain disabled until the external differential receiver /
# level interface and all active levels have been electrically verified.
MPG_INPUTS_ENABLED="false"
MPG_ENCODER_ACTIVE_LOW="false"
MPG_USE_ROTARYIO="true"
MPG_SELECTOR_ACTIVE_LOW="true"
MPG_BUTTON_ACTIVE_LOW="true"
MPG_PIN_A="GPIO42"
MPG_PIN_B="GPIO41"
MPG_COUNTS_PER_DETENT="4"
MPG_DIRECTION="1"
MPG_AXIS_MAP_X="X"
MPG_AXIS_MAP_Y="Y"
MPG_AXIS_MAP_Z="Z"
MPG_AXIS_MAP_4="A"
MPG_AXIS_MAP_5="B"
MPG_AXIS_MAP_6="C"
MPG_PIN_AXIS_X="GPA0"
MPG_PIN_AXIS_Y="GPA1"
MPG_PIN_AXIS_Z="GPA2"
MPG_PIN_AXIS_4="GPA3"
MPG_PIN_AXIS_5="GPA4"
MPG_PIN_AXIS_6="GPA5"
MPG_PIN_MULTIPLIER_X1="GPA6"
MPG_PIN_MULTIPLIER_X10="GPA7"
MPG_PIN_MULTIPLIER_X100="GPB0"
# LOCAL Orange/Black contact; LOCAL Pink/Black returns to common. These are
# not the MAIN cable conductors with the same colors.
MPG_PIN_BUTTON_SELECT="GPB2"
MPG_PIN_BUTTON_BACK="GPB3"
MPG_PIN_BUTTON_FN="GPB4"
MPG_PIN_BUTTON_CANCEL="GPB5"
# Firmware-observed remote stop only; not a safety-rated cabinet E-stop.
MPG_PIN_ESTOP_OBSERVE="GPB1"
MPG_ESTOP_ACTIVE_LOW="true"
MPG_PIN_DEADMAN="GPB6"
MPG_DEADMAN_ACTIVE_LOW="true"
MPG_BUTTON_DEBOUNCE="0.03"
MPG_BUTTON_LONG_PRESS="0.8"

# Reference profile selector backend. Keep verification false until COM/contact
# behavior and the MCP23017 wiring have been electrically checked.
MPG_SELECTOR_BACKEND="mcp23017"
MPG_SELECTOR_INTERFACE_VERIFIED="false"
MPG_I2C_SDA_PIN="D4"
MPG_I2C_SCL_PIN="D5"
MPG_MCP23017_ADDRESS="32"

# Shared SPI routing metadata.
MPG_SPI_SCK_PIN="D8"
MPG_SPI_MOSI_PIN="D10"
MPG_SPI_MISO_PIN="D9"

# Display profile/controller settings remain independent of the board profile.
# Round Display reservations: D0/GPIO1 battery sense, D7/GPIO44 touch IRQ;
# touch and RTC share D4/D5 I2C with the MCP23017. Do not reuse these pins.
MPG_DISPLAY_ENABLED="false"
MPG_DISPLAY_USE_BOARD_DISPLAY="false"
MPG_DISPLAY_WIDTH="240"
MPG_DISPLAY_HEIGHT="240"
MPG_DISPLAY_ROTATION="0"
MPG_DISPLAY_DRIVER="gc9a01"
MPG_DISPLAY_RENDERER="round"
MPG_ROUND_UI_BOOTSTRAP="false"
MPG_DISPLAY_SCK_PIN="D8"
MPG_DISPLAY_MOSI_PIN="D10"
MPG_DISPLAY_CS_PIN="D1"
MPG_DISPLAY_DC_PIN="D3"
MPG_DISPLAY_RESET_PIN=""
MPG_DISPLAY_BACKLIGHT_PIN="D6"
MPG_DISPLAY_TOUCH_SDA_PIN="D4"
MPG_DISPLAY_TOUCH_SCL_PIN="D5"
MPG_TOUCH_ENABLED=false

# Optional physical SD mount. All four SPI pins are required when enabled.
MPG_SD_ENABLED="false"
MPG_SD_SCK_PIN="D8"
MPG_SD_MOSI_PIN="D10"
MPG_SD_MISO_PIN="D9"
MPG_SD_CS_PIN="D2"
MPG_SD_MOUNT_PATH="/sd"

# Never enable until the LED voltage/current and external driver are verified.
MPG_INDICATOR_ENABLED="false"
MPG_INDICATOR_ELECTRICALLY_VERIFIED="false"
MPG_INDICATOR_PIN=""
MPG_INDICATOR_ACTIVE_HIGH="true"
